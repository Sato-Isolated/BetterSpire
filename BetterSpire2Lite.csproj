<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>BetterSpire2Lite</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>13</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ModId>BetterSpire2Lite</ModId>
    <ModName>BetterSpire Guardian</ModName>
    <ModAuthor>jdr, MindLated</ModAuthor>
    <ModDescription>Compact borderless hand thumbnails (F3), auto-fitted settings (F1), shared HUD controls, coexisting draggable damage meter (F6), poison attribution and journal (F5). Source preview, compilation and in-game validation required.</ModDescription>
    <ModForkedFrom>https://www.nexusmods.com/slaythespire2/mods/2</ModForkedFrom>
    <ModVersion>3.5.3-compact-hud-preview</ModVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <Target Name="GenerateModManifest" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <ModManifestLines Include="{" />
      <ModManifestLines Include="  &quot;id&quot;: &quot;$(ModId)&quot;," />
      <ModManifestLines Include="  &quot;name&quot;: &quot;$(ModName)&quot;," />
      <ModManifestLines Include="  &quot;author&quot;: &quot;$(ModAuthor)&quot;," />
      <ModManifestLines Include="  &quot;description&quot;: &quot;$(ModDescription)&quot;," />
      <ModManifestLines Include="  &quot;version&quot;: &quot;$(ModVersion)&quot;," />
      <ModManifestLines Include="  &quot;has_pck&quot;: false," />
      <ModManifestLines Include="  &quot;has_dll&quot;: true," />
      <ModManifestLines Include="  &quot;dependencies&quot;: []," />
      <ModManifestLines Include="  &quot;affects_gameplay&quot;: false," />
      <ModManifestLines Include="  &quot;forked_from&quot;: &quot;$(ModForkedFrom)&quot;" />
      <ModManifestLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(TargetDir)$(ModId).json" Lines="@(ModManifestLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <ItemGroup>
    <Reference Include="GodotSharp">
      <HintPath>references/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>references/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>references/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
